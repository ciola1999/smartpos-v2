{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"fs:default",
		"fs:allow-app-log-dir-write",
		"fs:allow-app-log-dir-read",
		"sql:default",
		"sql:allow-execute",
		"sql:allow-select",
		"log:default"
	]
}
